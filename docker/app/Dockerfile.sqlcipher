# PHP 8.4 image variant WITH pdo_sqlcipher, for exercising whole-file
# SQLCipher encryption of the catalog (section 8, scope 2). Whole-file
# encryption is optional and capability-gated; this image is the reference
# environment where it is available so `doctor` reports whole_file mode.
FROM php:8.4-cli

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential libsqlcipher-dev git unzip \
    && rm -rf /var/lib/apt/lists/*

# Build pdo_sqlite against SQLCipher so PRAGMA key works (pdo_sqlcipher).
RUN docker-php-source extract \
    && cd /usr/src/php/ext/pdo_sqlite \
    && phpize \
    && ./configure --with-pdo-sqlite=/usr LDFLAGS="-lsqlcipher" CFLAGS="-DSQLITE_HAS_CODEC" \
    && make && make install \
    && docker-php-ext-enable pdo_sqlite \
    && docker-php-source delete

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /app
